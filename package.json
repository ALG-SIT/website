{
  "name": "alg-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "dev": "bun run fonts:dev && astro dev --host 0.0.0.0",
    "build": "bun run validate:content && astro build && bun run fonts:build && bun run search:build && bun run verify",
    "preview": "astro preview --host 0.0.0.0",
    "check": "bun run validate:content && astro check",
    "lint": "markdownlint-cli2 && bun run format:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "bun scripts/verify-output.ts",
    "test": "bun test",
    "test:content": "bun scripts/test-content.ts",
    "test:e2e": "playwright test",
    "audit:performance": "bun scripts/audit-performance.ts",
    "validate:content": "bun scripts/validate-source.ts",
    "fonts:dev": "bun scripts/build-fonts.mjs",
    "fonts:build": "bun scripts/build-fonts.mjs --built",
    "search:build": "bun scripts/build-search.ts"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.5",
    "@astrojs/mdx": "8.1.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.2",
    "satteri": "0.10.5",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@fontsource/noto-sans-jp": "^5.3.1",
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.4",
    "cheerio": "^1.2.0",
    "chrome-launcher": "^1.2.2",
    "lighthouse": "^13.5.0",
    "markdownlint-cli2": "^0.24.0",
    "pagefind": "1.5.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "subset-font": "^2.9.0",
    "typescript": "6",
    "yaml": "^2.9.1"
  }
}
