---
import PageHeading from '../../components/PageHeading.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Base from '../../layouts/Base.astro';
import { publishedProjects } from '../../lib/content';

const projects = await publishedProjects();
---

<Base
  title="プロジェクト"
  description="ALGのプロジェクト紹介。AI・GPU・Webなど、アイデアをかたちにする取り組み。"
>
  <div class="container page-shell">
    <PageHeading
      eyebrow="WHAT WE BUILD"
      title="アイデアの、その先へ。"
      description="小さな実験も、大きな挑戦も。つくりながら見つける、新しい可能性。"
    />
    <div
      class="grid grid-cols-2 gap-6 max-[767px]:grid-cols-1 max-[767px]:gap-5"
    >
      {projects.map((project, index) => (
        <ProjectCard project={project} index={index} />
      ))}
      {!projects.length && (
        <p class="col-span-full border border-dashed border-[var(--line)] p-10 text-center text-[var(--muted)]">
          プロジェクトの公開を準備しています。
        </p>
      )}
    </div>
  </div>
</Base>
