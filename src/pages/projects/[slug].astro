---
import { render } from 'astro:content';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ButtonLink from '../../components/ButtonLink.astro';
import ContentImage from '../../components/ContentImage.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import { statuses } from '../../data/tags';
import Base from '../../layouts/Base.astro';
import { publishedProjects, resolveAuthors } from '../../lib/content';
import { socialImage } from '../../lib/social-image';
export async function getStaticPaths() {
  return (await publishedProjects()).map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}
const { project } = Astro.props;
const { Content, headings } = await render(project);
const authors = await resolveAuthors(project.data.authors);
const toc = headings.filter(
  (heading) => heading.depth === 2 || heading.depth === 3,
);
const image = await socialImage(project.data.cover, project.data.coverAlt);
const breadcrumbs = [
  { name: 'ホーム', path: '/' },
  { name: 'プロジェクト', path: '/projects/' },
  { name: project.data.title, path: `/projects/${project.id}/` },
];
---

<Base
  title={project.data.title}
  description={project.data.description}
  image={image}
  breadcrumbs={breadcrumbs}
>
  <div class="container page-shell">
    <Breadcrumbs items={breadcrumbs} />
    <article data-pagefind-body>
      <header
        class="article-header mb-10 max-w-[900px] border-b border-[var(--line)] pb-[35px]"
      >
        <Eyebrow>PROJECT / {statuses[project.data.status]}</Eyebrow>
        {project.data.draft && (
          <span class="draft-badge">下書き・ローカル限定</span>
        )}
        <h1
          class="my-5 break-words text-[clamp(1.9rem,4vw,2.7rem)] max-[767px]:text-[28px]"
          data-pagefind-meta="title"
        >
          {project.data.title}
        </h1>
        <p
          class="article-description text-[15px] leading-[2] text-[var(--muted)] max-[767px]:text-sm"
        >
          {project.data.description}
        </p>
        <div class="flex flex-wrap gap-[7px]">
          {project.data.technologies.map((tech) => (
            <span class="project-technology">{tech}</span>
          ))}
        </div>
        <div class="project-links mt-[25px] flex flex-wrap gap-3">
          {project.data.repositoryUrl && (
            <ButtonLink href={project.data.repositoryUrl} variant="secondary">
              GitHubで見る ↗
            </ButtonLink>
          )}
          {project.data.websiteUrl && (
            <ButtonLink href={project.data.websiteUrl}>
              プロジェクトを開く ↗
            </ButtonLink>
          )}
        </div>
        {authors.length > 0 && (
          <p class="article-meta">
            参加：{authors.map((author) => author.data.displayName).join('・')}
          </p>
        )}
        {project.data.cover && (
          <ContentImage
            class="article-cover mt-[30px] w-full rounded-lg"
            src={project.data.cover}
            alt={project.data.coverAlt ?? project.data.title}
            kind="cover"
          />
        )}
      </header>
      <div class="article-layout">
        <div class="prose">
          <Content />
        </div>
        {toc.length > 0 && (
          <aside class="toc" data-pagefind-ignore>
            <nav aria-label="プロジェクトの目次">
              <p>
                ON THIS PAGE <span>目次</span>
              </p>
              <ol>
                {toc.map((heading) => (
                  <li class:list={{ 'toc-sub': heading.depth === 3 }}>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          </aside>
        )}
      </div>
    </article>
    <a
      class="back-link mt-10 inline-block text-[13px] text-[var(--accent)]"
      href="/projects/"
    >
      ← プロジェクト一覧に戻る
    </a>
  </div>
</Base>

<style>
.project-technology {
  padding: 3px 8px;
  border: 1px solid var(--line);
  border-radius: 3px;
  background: var(--surface-soft);
  color: var(--muted);
  font-family: var(--font-mono);
  font-size: 10px;
}
</style>
