---
import PageHeading from '../components/PageHeading.astro';
import { site } from '../data/site';
import Base from '../layouts/Base.astro';

const hasContact = site.contactEmail || site.social.length;
---

<Base title="連絡先・SNS" description="ALGの公式連絡先・SNSのご案内。">
  <div class="container page-shell">
    <PageHeading
      eyebrow="LET'S CONNECT"
      title="ここから、つながろう。"
      description="活動に関するお問い合わせや、最新の情報はこちらから。"
    />
    <div class="max-w-[800px]">
      {!hasContact && (
        <div class="info-panel">
          <h2>入部・見学の窓口を準備しています</h2>
          <p>
            募集用の連絡先と公式SNSは、管理担当者による確認後に掲載します。下記のGitHubはソースコードの公開先です。
          </p>
        </div>
      )}
      <div class="mt-[30px] grid gap-[15px]">
        {site.github && (
          <a class="contact-link" href={site.github}>
            <strong class="text-[15px]">GitHub</strong>
            <span class="text-xs text-[var(--muted)]">
              ソースコード・公開プロジェクト ↗
            </span>
          </a>
        )}
        {site.contactEmail && (
          <a class="contact-link" href={`mailto:${site.contactEmail}`}>
            <strong class="text-[15px]">メール</strong>
            <span class="text-xs text-[var(--muted)]">
              {site.contactEmail} ↗
            </span>
          </a>
        )}
        {site.social.map((social) => (
          <a class="contact-link" href={social.url}>
            <strong class="text-[15px]">{social.label}</strong>
            <span class="text-xs text-[var(--muted)]">公式アカウント ↗</span>
          </a>
        ))}
      </div>
      <div class="prose mt-[35px]">
        <h2>入部・見学をお考えの方へ</h2>
        <p>
          参加条件や募集状況は<a href="/join/">入部案内</a>でご確認ください。
        </p>
        <h2>記事の訂正について</h2>
        <p>記事や掲載内容の訂正窓口は、決まり次第このページで案内します。</p>
        <p>このサイトには問い合わせフォームを設置していません。</p>
      </div>
    </div>
  </div>
</Base>

<style>
.contact-link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 22px;
  border: 1px solid var(--line);
  border-radius: 6px;
  background: var(--surface);
}

.contact-link:hover {
  border-color: var(--accent);
}
</style>
