---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ContentImage from '../../components/ContentImage.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import PostCard from '../../components/PostCard.astro';
import { site } from '../../data/site';
import { categories, tags } from '../../data/tags';
import Base from '../../layouts/Base.astro';
import { publishedBlog, relatedPosts, resolveAuthors } from '../../lib/content';
import { formatDate } from '../../lib/publishing';
import { organizationId } from '../../lib/seo';
import { socialImage } from '../../lib/social-image';
export async function getStaticPaths() {
  return (await publishedBlog()).map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
const authors = await resolveAuthors(post.data.authors);
const related = relatedPosts(post, await publishedBlog());
const toc = headings.filter(
  (heading) => heading.depth === 2 || heading.depth === 3,
);
const image = await socialImage(post.data.cover, post.data.coverAlt);
const breadcrumbs = [
  { name: 'ホーム', path: '/' },
  { name: '記事', path: '/blog/' },
  { name: post.data.title, path: `/blog/${post.id}/` },
];
const structured = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publishedAt.toISOString(),
  ...(post.data.updatedAt
    ? { dateModified: post.data.updatedAt.toISOString() }
    : {}),
  author: authors.map((author) => ({
    '@type': author.id === 'alg' ? 'Organization' : 'Person',
    name: author.data.displayName,
  })),
  publisher: { '@id': organizationId },
  mainEntityOfPage: new URL(`/blog/${post.id}/`, site.url).href,
  ...(post.data.cover ? { image: new URL(image.src, site.url).href } : {}),
};
---

<Base
  title={post.data.title}
  description={post.data.description}
  image={image}
  structuredData={[structured]}
  breadcrumbs={breadcrumbs}
  ogType="article"
  publishedAt={post.data.publishedAt}
  updatedAt={post.data.updatedAt}
>
  <div class="container page-shell">
    <Breadcrumbs items={breadcrumbs} />
    <article data-pagefind-body>
      <header
        class="article-header mb-10 max-w-[900px] border-b border-[var(--line)] pb-[35px]"
      >
        <span class="category-label">{categories[post.data.category]}</span>
        {post.data.draft && (
          <span class="draft-badge">下書き・ローカル限定</span>
        )}
        <h1
          class="my-5 break-words text-[clamp(1.9rem,4vw,2.7rem)] max-[767px]:text-[28px]"
          data-pagefind-meta="title"
        >
          {post.data.title}
        </h1>
        <p
          class="article-description text-[15px] leading-[2] text-[var(--muted)] max-[767px]:text-sm"
        >
          {post.data.description}
        </p>
        <div class="article-meta">
          <span>
            {authors.map((author) => author.data.displayName).join('・')}
          </span>
          <time datetime={post.data.publishedAt.toISOString()}>
            公開 {formatDate(post.data.publishedAt)}
          </time>
          {post.data.updatedAt && (
            <time datetime={post.data.updatedAt.toISOString()}>
              更新 {formatDate(post.data.updatedAt)}
            </time>
          )}
        </div>
        <div
          class="mt-5 flex flex-wrap gap-2 text-[11px] text-[var(--muted)] [&>a:hover]:text-[var(--accent)]"
        >
          {post.data.tags.map((id) => (
            <a href={`/tags/${id}/`}>#{tags[id as keyof typeof tags]}</a>
          ))}
        </div>
        {post.data.cover && (
          <ContentImage
            class="article-cover mt-[30px] w-full rounded-lg"
            src={post.data.cover}
            alt={post.data.coverAlt ?? post.data.title}
            kind="cover"
          />
        )}
      </header>
      <div class="article-layout">
        <div class="prose">
          <Content />
        </div>
        {toc.length > 0 && (
          <aside class="toc" data-pagefind-ignore>
            <nav aria-label="この記事の目次">
              <p>
                ON THIS PAGE <span>目次</span>
              </p>
              <ol>
                {toc.map((heading) => (
                  <li class:list={{ 'toc-sub': heading.depth === 3 }}>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          </aside>
        )}
      </div>
      <section
        class="authors-section"
        data-pagefind-ignore
        aria-label="著者紹介"
      >
        {authors.map((author) => (
          <div class="author-profile">
            {author.data.avatar ? (
              <Image
                class="author-avatar"
                src={author.data.avatar}
                alt={`${author.data.displayName}のアバター`}
                width={56}
                height={56}
              />
            ) : (
              <span class="author-avatar" aria-hidden="true">
                {author.data.displayName.slice(0, 1)}
              </span>
            )}
            <div>
              <strong>{author.data.displayName}</strong>
              {author.data.bio && <p>{author.data.bio}</p>}
              <div class="author-links">
                {author.data.github && (
                  <a href={author.data.github}>GitHub ↗</a>
                )}
                {author.data.website && (
                  <a href={author.data.website}>Webサイト ↗</a>
                )}
              </div>
            </div>
          </div>
        ))}
      </section>
    </article>
    {related.length > 0 && (
      <section class="related-section">
        <div class="mb-8 flex items-end justify-between gap-5 [&_.eyebrow]:mb-[11px]">
          <div>
            <Eyebrow>KEEP EXPLORING</Eyebrow>
            <h2>こちらもどうぞ。</h2>
          </div>
        </div>
        <div class="grid grid-cols-3 gap-6 max-[1023px]:gap-[15px] max-[767px]:grid-cols-1 max-[767px]:gap-5">
          {related.map((entry, index) => (
            <PostCard post={entry} index={index} />
          ))}
        </div>
      </section>
    )}
    <a
      class="back-link mt-10 inline-block text-[13px] text-[var(--accent)]"
      href="/blog/"
    >
      ← 記事一覧に戻る
    </a>
  </div>
</Base>

<style>
.category-label {
  display: inline-flex;
  padding: 3px 9px;
  border-radius: 3px;
  background: color-mix(in srgb, var(--accent) 9%, transparent);
  color: var(--accent);
  font-size: 10px;
}

@media (max-width: 767px) {
  .category-label {
    font-size: 11px;
  }
}
</style>
