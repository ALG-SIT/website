---
import ButtonLink from '../components/ButtonLink.astro';
import Icon from '../components/Icon.astro';
import Base from '../layouts/Base.astro';
---

<Base
  title="ページが見つかりません"
  description="お探しのページは移動したか、存在しないようです。Ai Love GPUのホームや記事一覧からお探しください。"
  noindex
>
  <div class="container page-shell">
    <p class="mb-0 font-mono text-[100px] text-[var(--accent)]">
      404<span class="text-[.5em]">_</span>
    </p>
    <h1>ここは、まだ未開拓。</h1>
    <p
      class="mb-0 max-w-[700px] text-[15px] leading-[2] text-[var(--muted)] max-[767px]:text-[13px]"
    >
      お探しのページは移動したか、存在しないようです。
      <br>
      ホームや記事一覧から、もう一度探してみてください。
    </p>
    <div class="flex flex-wrap gap-3">
      <ButtonLink href="/">
        ホームに戻る <Icon name="arrow" size={18} />
      </ButtonLink>
      <ButtonLink href="/blog/" variant="secondary"> 記事を探す </ButtonLink>
    </div>
  </div>
</Base>
