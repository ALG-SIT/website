---
import BrandSquare from '../components/BrandSquare.astro';
import Icon from '../components/Icon.astro';
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Base from '../layouts/Base.astro';
import { publishedBlog, publishedProjects } from '../lib/content';

const posts = (await publishedBlog()).slice(0, 3);
const projects = (await publishedProjects())
  .filter((project) => project.data.featured)
  .slice(0, 3);
const activities = [
  {
    number: '01',
    icon: 'chip' as const,
    title: '計算資源を、共有する。',
    english: 'BUILD & OPERATE',
    text: 'AI・機械学習に必要なGPU資源を共同で使うために。機材の選定から保守まで、学生の手で計算基盤を構築・運用します。',
  },
  {
    number: '02',
    icon: 'code' as const,
    title: 'AIで、アイデアをかたちに。',
    english: 'BUILD & CREATE',
    text: 'Discordで開発の知見を共有し、個人開発やチーム開発へ。ワークショップ、LT会、展示会で作品と工夫を伝え合う場をつくります。',
  },
  {
    number: '03',
    icon: 'people' as const,
    title: '数学と理論から、学ぶ。',
    english: 'LEARN & UNDERSTAND',
    text: 'AIの基礎となる数学と理論を、勉強会やセミナーで。入門から専門的な内容まで、それぞれの理解に合わせて学びを深める場をつくります。',
  },
];
---

<Base
  description="芝浦工業大学の学生団体ALG（AI Love GPU）。共有GPU資源の運用、AI駆動開発、勉強会とセミナーの活動・計画を紹介します。"
>
  <section class="hero grid-background">
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">
          <span></span>
          AI LOVE GPU / SHIBAURA INSTITUTE OF TECHNOLOGY
        </p>
        <h1>
          好奇心を、
          <br>
          <span>動かそう。</span>
        </h1>
        <p class="hero-description">
          AIを学び、作り、動かす。
          <br>
          芝浦工業大学の仲間と、アイデアを形に。
        </p>
        <div class="hero-buttons">
          <a href="/about/" class="button button-primary">
            ALGについて知る <Icon name="arrow" size={18} />
          </a>
          <a href="/blog/" class="button button-secondary">
            技術記事を読む <Icon name="arrow" size={18} />
          </a>
        </div>
        <div class="hero-caption">
          <span class="status-dot"></span>
          LEARN. BUILD. SHARE.
        </div>
      </div>
      <div
        class="hero-logo"
        role="img"
        aria-label="AIとGPU、ピンクのハートを組み合わせたAI Love GPUのロゴ"
      >
        <BrandSquare />
      </div>
    </div>
    <div class="container hero-bottom">
      <span>POWERED BY CURIOSITY, NOT JUST COMPUTE.</span>
      <span> SCROLL TO EXPLORE <span aria-hidden="true">↓</span> </span>
    </div>
  </section>
  <section class="section container">
    <div class="section-header">
      <div>
        <p class="eyebrow">OUR ACTIVITIES</p>
        <h2>学びと開発をつなぐ、3つの活動。</h2>
      </div>
      <a class="text-link" href="/about/">
        私たちについて <Icon name="arrow" size={18} />
      </a>
    </div>
    <p class="section-intro">
      ALG（AI Love GPU）は、芝浦工業大学の学生が、
      <br class="desktop-break">
      計算資源・開発力・理論の理解を共同で身につける団体です。
    </p>
    <div class="activities-grid">
      {activities.map((activity) => (
        <article class="activity-card">
          <div class="activity-card-top">
            <Icon name={activity.icon} size={27} />
            <span>{activity.number}</span>
          </div>
          <p class="activity-english">{activity.english}</p>
          <h3>{activity.title}</h3>
          <p>{activity.text}</p>
        </article>
      ))}
    </div>
  </section>
  <section class="section section-tinted">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">LATEST NOTES</p>
          <h2>試したこと、学んだこと。</h2>
        </div>
        <a class="text-link" href="/blog/">
          すべての記事 <Icon name="arrow" size={18} />
        </a>
      </div>
      <div class="post-grid">
        {posts.map((post, index) => <PostCard post={post} index={index} />)}
        {!posts.length && (
          <p class="empty-state">最初の記事を準備しています。</p>
        )}
      </div>
    </div>
  </section>
  <section class="section container">
    <div class="section-header">
      <div>
        <p class="eyebrow">FEATURED PROJECTS</p>
        <h2>アイデアの、その先へ。</h2>
      </div>
      <a class="text-link" href="/projects/">
        すべてのプロジェクト <Icon name="arrow" size={18} />
      </a>
    </div>
    <div class="project-grid">
      {projects.map((project, index) => (
        <ProjectCard project={project} index={index} />
      ))}
      {!projects.length && (
        <p class="empty-state">プロジェクトの公開を準備しています。</p>
      )}
    </div>
  </section>
  <section class="container join-section">
    <div class="join-panel">
      <div>
        <p class="eyebrow"><span></span> YOUR NEXT EXPERIMENT STARTS HERE</p>
        <h2>
          その好奇心、
          <br class="mobile-break">
          一緒に育てよう。
        </h2>
        <p>
          「AIが気になる」「何かつくってみたい」
          <br>
          その気持ちから、はじめてみませんか。
        </p>
      </div>
      <a href="/join/" class="button button-primary">
        入部案内を見る <Icon name="arrow" size={20} />
      </a>
      <span class="join-decoration" aria-hidden="true"> + </span>
    </div>
  </section>
</Base>
