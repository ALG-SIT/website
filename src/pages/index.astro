---
import ChipArt from '../components/ChipArt.astro';
import Icon from '../components/Icon.astro';
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Base from '../layouts/Base.astro';
import { publishedBlog, publishedProjects } from '../lib/content';

const posts = (await publishedBlog()).slice(0, 3);
const projects = (await publishedProjects())
  .filter((project) => project.data.featured)
  .slice(0, 3);
const activities = [
  {
    number: '01',
    icon: 'chip' as const,
    title: 'AIを、深く知る。',
    english: 'LEARN & EXPERIMENT',
    text: '機械学習の基礎から、気になる最新技術まで。手を動かし、仕組みをひもとく。',
  },
  {
    number: '02',
    icon: 'code' as const,
    title: 'アイデアを、かたちに。',
    english: 'BUILD & CREATE',
    text: 'GPUやコードを使って、思いつきを動くものに。小さな実験から、次のプロジェクトへ。',
  },
  {
    number: '03',
    icon: 'people' as const,
    title: '学びを、ひらく。',
    english: 'SHARE & CONNECT',
    text: 'うまくいったことも、つまずいたことも。記事や対話を通じて、仲間と共有する。',
  },
];
---

<Base
  description="AIを学び、GPUで試し、仲間とつくる。Ai Love GPU（ALG）の公式サイト。最新記事やプロジェクト、参加方法を紹介します。"
>
  <section class="hero grid-background">
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow"><span></span> AI LOVE GPU / TECH COMMUNITY</p>
        <h1>
          好奇心を、
          <br>
          <span>動かそう。</span>
        </h1>
        <p class="hero-description">
          AIを学ぶ。GPUで試す。仲間とつくる。
          <br>
          まだ知らない可能性を、ここから。
        </p>
        <div class="hero-buttons">
          <a href="/about/" class="button button-primary">
            ALGについて知る <Icon name="arrow" size={18} />
          </a>
          <a href="/blog/" class="button button-secondary">
            技術記事を読む <Icon name="arrow" size={18} />
          </a>
        </div>
        <div class="hero-caption">
          <span class="status-dot"></span>
          LEARN. BUILD. SHARE.
        </div>
      </div>
      <ChipArt />
    </div>
    <div class="container hero-bottom">
      <span>POWERED BY CURIOSITY, NOT JUST COMPUTE.</span>
      <span> SCROLL TO EXPLORE <span aria-hidden="true">↓</span> </span>
    </div>
  </section>
  <section class="section container">
    <div class="section-header">
      <div>
        <p class="eyebrow">OUR MINDSET</p>
        <h2>「やってみたい」が、出発点。</h2>
      </div>
      <a class="text-link" href="/about/">
        私たちについて <Icon name="arrow" size={18} />
      </a>
    </div>
    <p class="section-intro">
      Ai Love GPUは、AIやGPUをはじめとする技術を、
      <br class="desktop-break">
      学び、試し、共有するサークルです。専門知識よりも、まずは好奇心。
    </p>
    <div class="activities-grid">
      {activities.map((activity) => (
        <article class="activity-card">
          <div class="activity-card-top">
            <Icon name={activity.icon} size={27} />
            <span>{activity.number}</span>
          </div>
          <p class="activity-english">{activity.english}</p>
          <h3>{activity.title}</h3>
          <p>{activity.text}</p>
        </article>
      ))}
    </div>
  </section>
  <section class="section section-tinted">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">LATEST NOTES</p>
          <h2>試したこと、学んだこと。</h2>
        </div>
        <a class="text-link" href="/blog/">
          すべての記事 <Icon name="arrow" size={18} />
        </a>
      </div>
      <div class="post-grid">
        {posts.map((post, index) => <PostCard post={post} index={index} />)}
        {!posts.length && (
          <p class="empty-state">最初の記事を準備しています。</p>
        )}
      </div>
    </div>
  </section>
  <section class="section container">
    <div class="section-header">
      <div>
        <p class="eyebrow">FEATURED PROJECTS</p>
        <h2>アイデアの、その先へ。</h2>
      </div>
      <a class="text-link" href="/projects/">
        すべてのプロジェクト <Icon name="arrow" size={18} />
      </a>
    </div>
    <div class="project-grid">
      {projects.map((project, index) => (
        <ProjectCard project={project} index={index} />
      ))}
      {!projects.length && (
        <p class="empty-state">プロジェクトの公開を準備しています。</p>
      )}
    </div>
  </section>
  <section class="container join-section">
    <div class="join-panel">
      <div>
        <p class="eyebrow"><span></span> YOUR NEXT EXPERIMENT STARTS HERE</p>
        <h2>
          その好奇心、
          <br class="mobile-break">
          一緒に育てよう。
        </h2>
        <p>
          「AIが気になる」「何かつくってみたい」
          <br>
          その気持ちから、はじめてみませんか。
        </p>
      </div>
      <a href="/join/" class="button button-primary">
        入部案内を見る <Icon name="arrow" size={20} />
      </a>
      <span class="join-decoration" aria-hidden="true"> + </span>
    </div>
  </section>
</Base>
