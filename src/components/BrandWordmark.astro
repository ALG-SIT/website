---
import { Image } from 'astro:assets';
import darkWordmark from '../../public/brand-wordmark-dark.png';
import lightWordmark from '../../public/brand-wordmark-light.png';
---

<span class="brand-wordmark" aria-hidden="true">
  <Image
    class="brand-wordmark-light"
    src={lightWordmark}
    width={540}
    widths={[270, 540]}
    sizes="(max-width: 600px) 190px, 270px"
    loading="eager"
    alt=""
  />
  <Image
    class="brand-wordmark-dark"
    src={darkWordmark}
    width={540}
    widths={[270, 540]}
    sizes="(max-width: 600px) 190px, 270px"
    loading="eager"
    alt=""
  />
</span>
