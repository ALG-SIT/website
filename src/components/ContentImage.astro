---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  kind: 'post-card' | 'project-card' | 'cover';
  class?: string;
}
const { src, alt, kind, class: className } = Astro.props;
const cover = kind === 'cover';
const width = cover ? 1200 : kind === 'post-card' ? 720 : 800;
const height = cover ? undefined : 400;
const widths = cover
  ? [400, 800, 1200]
  : kind === 'post-card'
    ? [360, 540, 720]
    : [400, 600, 800];
const sizes = cover
  ? '(max-width: 600px) calc(100vw - 40px), (max-width: 1200px) calc(100vw - 72px), 1168px'
  : '(max-width: 600px) calc(100vw - 40px), (max-width: 1000px) calc((100vw - 72px) / 2), 370px';
---

<Image
  src={src}
  alt={alt}
  class={className}
  width={width}
  height={height}
  widths={src.format === 'svg' ? undefined : widths}
  sizes={src.format === 'svg' ? undefined : sizes}
  loading={cover ? 'eager' : 'lazy'}
  priority={cover}
/>
