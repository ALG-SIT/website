---
import type { Breadcrumb } from '../lib/seo';

interface Props {
  items: Breadcrumb[];
}
const { items } = Astro.props;
---

<nav
  class="breadcrumbs mb-10 flex flex-wrap gap-[13px] text-[11px] text-[var(--muted)] max-[767px]:mb-[25px] max-[767px]:text-[10px]"
  aria-label="パンくず"
>
  {items.map((item, index) => (
    <>
      {index > 0 && <span aria-hidden="true">/</span>}
      {index === items.length - 1 ? (
        <span aria-current="page">{item.name}</span>
      ) : (
        <a class="hover:text-[var(--accent)]" href={item.path}>
          {item.name}
        </a>
      )}
    </>
  ))}
</nav>
