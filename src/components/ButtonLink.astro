---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  class?: string;
}

const { href, variant = 'primary', class: className } = Astro.props;
---

<!-- biome-ignore lint/a11y/useAnchorContent: Callers provide visible text in the slot. -->
<a
  class:list={['button-link', `button-link--${variant}`, className]}
  href={href}
>
  <slot />
</a>

<style>
.button-link {
  display: inline-flex;
  min-height: 46px;
  align-items: center;
  justify-content: center;
  gap: 18px;
  padding: 12px 21px;
  border: 1px solid transparent;
  border-radius: 5px;
  font-size: 13px;
  font-weight: 600;
  transition:
    border-color 150ms,
    background 150ms;
}

.button-link--primary {
  background: var(--accent);
  color: var(--accent-text);
}

.button-link--primary:hover {
  background: color-mix(in srgb, var(--accent-bright) 88%, var(--text));
}

.button-link--secondary {
  border-color: var(--line);
  background: var(--bg);
  color: var(--text);
}

.button-link--secondary:hover {
  border-color: var(--accent);
}

@media (max-width: 1023px) {
  .button-link {
    gap: 10px;
    padding: 11px 14px;
    font-size: 11px;
  }
}

@media (max-width: 767px) {
  .button-link {
    padding: 12px 16px;
    font-size: 12px;
  }
}
</style>
