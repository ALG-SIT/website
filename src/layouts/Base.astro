---
import '../styles/global.css';
import { Font } from 'astro:assets';
import BrandWordmark from '../components/BrandWordmark.astro';
import Icon from '../components/Icon.astro';
import { navigation, site } from '../data/site';
import {
  type Breadcrumb,
  breadcrumbList,
  defaultSocialImage,
  isPreview,
  organization,
  type SocialImage,
} from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  image?: SocialImage;
  noindex?: boolean;
  structuredData?: Record<string, unknown>[];
  breadcrumbs?: Breadcrumb[];
  ogType?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
}
const {
  title,
  description = site.description,
  image = defaultSocialImage,
  noindex = false,
  structuredData = [],
  breadcrumbs = [],
  ogType = 'website',
  publishedAt,
  updatedAt,
} = Astro.props;
const canonical = new URL(
  noindex && Astro.url.pathname === '/404/' ? '/404.html' : Astro.url.pathname,
  site.url,
).href;
const pageTitle = title
  ? `${title} | ${site.name}`
  : `${site.shortName}（${site.name}）｜芝浦工業大学のAI・GPU学生団体`;
const preview =
  import.meta.env.DEV ||
  isPreview(site.preview, import.meta.env.WORKERS_CI_BRANCH);
const structured = [
  organization(),
  ...(Astro.url.pathname === '/'
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'WebSite',
          '@id': new URL('/#website', site.url).href,
          name: site.name,
          alternateName: site.shortName,
          url: new URL('/', site.url).href,
        },
      ]
    : []),
  ...structuredData,
  ...(breadcrumbs.length ? [breadcrumbList(breadcrumbs)] : []),
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8">
    <Font cssVariable="--font-alg" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{pageTitle}</title>
    <meta name="description" content={description}>
    <link rel="canonical" href={canonical}>
    {(noindex || preview) && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content={ogType}>
    <meta property="og:site_name" content={site.name}>
    <meta property="og:title" content={pageTitle}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonical}>
    <meta property="og:image" content={new URL(image.src, site.url).href}>
    <meta property="og:image:width" content={String(image.width)}>
    <meta property="og:image:height" content={String(image.height)}>
    <meta property="og:image:type" content={image.type}>
    <meta property="og:image:alt" content={image.alt}>
    {ogType === 'article' && publishedAt && (
      <meta
        property="article:published_time"
        content={publishedAt.toISOString()}
      />
    )}
    {ogType === 'article' && updatedAt && (
      <meta
        property="article:modified_time"
        content={updatedAt.toISOString()}
      />
    )}
    <meta property="og:locale" content="ja_JP">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={pageTitle}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={new URL(image.src, site.url).href}>
    <meta name="twitter:image:alt" content={image.alt}>
    <meta name="color-scheme" content="dark light">
    <meta
      name="theme-color"
      content="#ffffff"
      media="(prefers-color-scheme: light)"
    >
    <meta
      name="theme-color"
      content="#171417"
      media="(prefers-color-scheme: dark)"
    >
    <link
      rel="icon"
      type="image/x-icon"
      sizes="16x16 32x32 48x48"
      href="/favicon.ico"
    >
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png">
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link
      rel="alternate"
      type="application/rss+xml"
      title="ALGの記事"
      href="/rss.xml"
    >
    <script is:inline>
    (() => {
      let preference = 'system';
      try {
        const stored = localStorage.getItem('alg-theme');
        if (stored === 'light' || stored === 'dark') preference = stored;
      } catch {
        /* 保存できない場合はOS設定に追従 */
      }
      const theme =
        preference === 'system'
          ? matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light'
          : preference;
      document.documentElement.dataset.themePreference = preference;
      document.documentElement.dataset.theme = theme;
      document.querySelectorAll('meta[name="theme-color"]').forEach((meta) => {
        meta.setAttribute('content', theme === 'dark' ? '#171417' : '#ffffff');
        meta.removeAttribute('media');
      });
    })();
    </script>
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structured).replace(/</g, '\\u003c')}
    />
  </head>
  <body>
    <a href="#main" class="skip-link"> 本文へ移動 </a>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand" aria-label="ALG AI Love GPU ホーム">
          <BrandWordmark />
        </a>
        <nav class="desktop-nav" aria-label="メインナビゲーション">
          {navigation.map((item) => (
            <a
              href={item.href}
              aria-current={
                Astro.url.pathname.startsWith(item.href) ? 'page' : undefined
              }
            >
              {item.label}
            </a>
          ))}
        </nav>
        <div class="header-actions">
          <button
            type="button"
            class="icon-button search-trigger"
            aria-label="サイト内を検索"
            data-search-open
          >
            <Icon name="search" />
          </button>
          <fieldset class="theme-picker" aria-label="表示テーマ">
            {(
              [
                ['light', 'sun', 'ライト'],
                ['dark', 'moon', 'ダーク'],
                ['system', 'monitor', 'OS設定に従う'],
              ] as const
            ).map(([value, icon, label]) => (
              <button
                type="button"
                class="icon-button theme-button"
                data-theme-value={value}
                aria-label={label}
                aria-pressed="false"
                title={label}
              >
                <Icon name={icon} size={18} />
              </button>
            ))}
          </fieldset>
          <a href="/join/" class="header-join">
            参加する <Icon name="arrow" size={16} />
          </a>
          <button
            type="button"
            class="icon-button mobile-toggle"
            id="menu-toggle"
            aria-label="メニューを開く"
            aria-expanded="false"
            aria-controls="mobile-nav"
          >
            <Icon name="menu" />
          </button>
        </div>
      </div>
      <nav
        id="mobile-nav"
        class="mobile-nav container"
        aria-label="モバイルナビゲーション"
      >
        {navigation.map((item) => (
          <a
            href={item.href}
            aria-current={
              Astro.url.pathname.startsWith(item.href) ? 'page' : undefined
            }
          >
            {item.label}
          </a>
        ))}
        <a href="/contact/">連絡先</a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <div class="footer-top">
          <div>
            <a href="/" class="brand" aria-label="AI Love GPU ホーム">
              <BrandWordmark />
            </a>
            <p>
              好奇心を、動かそう。
              <br>
              AIを学び、GPUで試し、仲間とつくる。
            </p>
          </div>
          <div class="footer-links">
            <div>
              <span>EXPLORE</span>
              {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
            </div>
            <div>
              <span>CONNECT</span>
              <a href="/contact/">連絡先・SNS</a>
              {site.github && <a href={site.github}>GitHub ↗</a>}
              <a href="/rss.xml">RSSフィード ↗</a>
              <a href="/privacy/">プライバシーポリシー</a>
            </div>
          </div>
        </div>
        <div class="footer-bottom">
          <span>© {new Date().getFullYear()} AI Love GPU</span>
          <span>
            BUILT WITH CURIOSITY <span class="footer-plus">+</span> ASTRO
          </span>
        </div>
        {preview && (
          <p class="preview-note">
            このサイトは開発プレビューです。掲載内容は正式公開前に確認してください。
          </p>
        )}
      </div>
    </footer>
    <dialog id="search-dialog" aria-labelledby="search-title">
      <div class="search-heading">
        <h2 id="search-title">記事・プロジェクトを検索</h2>
        <button
          type="button"
          class="icon-button"
          data-search-close
          aria-label="検索を閉じる"
        >
          <Icon name="close" />
        </button>
      </div>
      <label for="search-input" class="sr-only"> 検索キーワード </label>
      <div class="search-field">
        <Icon name="search" />
        <input
          id="search-input"
          type="search"
          placeholder="例：機械学習、GPU、Python"
          autocomplete="off"
        >
      </div>
      <p id="search-status" role="status" aria-live="polite">
        キーワードを入力してください。
      </p>
      <ul id="search-results"></ul>
      <p class="search-hint">ESCで閉じる · 公開記事とプロジェクトを検索</p>
    </dialog>
    <script>
    import '../lib/browser';
    </script>
    <noscript>
      <style>
      .header-actions button {
        display: none;
      }
      .mobile-nav {
        display: flex;
        flex-wrap: wrap;
      }
      .filter-controls {
        display: none;
      }
      </style>
    </noscript>
  </body>
</html>
