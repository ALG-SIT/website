---
import '../styles/content.css';
import '../styles/global.css';
import { Font } from 'astro:assets';
import BrandWordmark from '../components/BrandWordmark.astro';
import Icon from '../components/Icon.astro';
import { navigation, site } from '../data/site';
import {
  type Breadcrumb,
  breadcrumbList,
  defaultSocialImage,
  isPreview,
  organization,
  type SocialImage,
} from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  image?: SocialImage;
  noindex?: boolean;
  structuredData?: Record<string, unknown>[];
  breadcrumbs?: Breadcrumb[];
  ogType?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
}
const {
  title,
  description = site.description,
  image = defaultSocialImage,
  noindex = false,
  structuredData = [],
  breadcrumbs = [],
  ogType = 'website',
  publishedAt,
  updatedAt,
} = Astro.props;
const canonical = new URL(
  noindex && Astro.url.pathname === '/404/' ? '/404.html' : Astro.url.pathname,
  site.url,
).href;
const pageTitle = title
  ? `${title} | ${site.name}`
  : `${site.shortName}（${site.name}）｜芝浦工業大学のAI・GPU学生団体`;
const preview =
  import.meta.env.DEV ||
  isPreview(site.preview, import.meta.env.WORKERS_CI_BRANCH);
const structured = [
  organization(),
  ...(Astro.url.pathname === '/'
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'WebSite',
          '@id': new URL('/#website', site.url).href,
          name: site.name,
          alternateName: site.shortName,
          url: new URL('/', site.url).href,
        },
      ]
    : []),
  ...structuredData,
  ...(breadcrumbs.length ? [breadcrumbList(breadcrumbs)] : []),
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8">
    <style is:inline>
    @layer theme, base, components, utilities;
    @media (max-width: 359px) {
      .icon-button--search,
      .mobile-toggle {
        width: 28px;
        height: 28px;
      }

      .icon-button--theme {
        width: 24px;
        height: 24px;
      }
    }
    </style>
    <Font cssVariable="--font-alg" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{pageTitle}</title>
    <meta name="description" content={description}>
    <link rel="canonical" href={canonical}>
    {(noindex || preview) && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content={ogType}>
    <meta property="og:site_name" content={site.name}>
    <meta property="og:title" content={pageTitle}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonical}>
    <meta property="og:image" content={new URL(image.src, site.url).href}>
    <meta property="og:image:width" content={String(image.width)}>
    <meta property="og:image:height" content={String(image.height)}>
    <meta property="og:image:type" content={image.type}>
    <meta property="og:image:alt" content={image.alt}>
    {ogType === 'article' && publishedAt && (
      <meta
        property="article:published_time"
        content={publishedAt.toISOString()}
      />
    )}
    {ogType === 'article' && updatedAt && (
      <meta
        property="article:modified_time"
        content={updatedAt.toISOString()}
      />
    )}
    <meta property="og:locale" content="ja_JP">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={pageTitle}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={new URL(image.src, site.url).href}>
    <meta name="twitter:image:alt" content={image.alt}>
    <meta name="color-scheme" content="dark light">
    <meta
      name="theme-color"
      content="#ffffff"
      media="(prefers-color-scheme: light)"
    >
    <meta
      name="theme-color"
      content="#171417"
      media="(prefers-color-scheme: dark)"
    >
    <link
      rel="icon"
      type="image/x-icon"
      sizes="16x16 32x32 48x48"
      href="/favicon.ico"
    >
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png">
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link
      rel="alternate"
      type="application/rss+xml"
      title="ALGの記事"
      href="/rss.xml"
    >
    <script is:inline>
    (() => {
      let preference = 'system';
      try {
        const stored = localStorage.getItem('alg-theme');
        if (stored === 'light' || stored === 'dark') preference = stored;
      } catch {
        /* 保存できない場合はOS設定に追従 */
      }
      const theme =
        preference === 'system'
          ? matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light'
          : preference;
      document.documentElement.dataset.themePreference = preference;
      document.documentElement.dataset.theme = theme;
      document.querySelectorAll('meta[name="theme-color"]').forEach((meta) => {
        meta.setAttribute('content', theme === 'dark' ? '#171417' : '#ffffff');
        meta.removeAttribute('media');
      });
    })();
    </script>
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structured).replace(/</g, '\\u003c')}
    />
  </head>
  <body>
    <a href="#main" class="skip-link"> 本文へ移動 </a>
    <header
      class="relative z-20 border-b border-[var(--line)] bg-[var(--header-bg)]"
    >
      <div
        class="header-inner container flex h-[88px] items-center gap-6 max-[1023px]:gap-5 max-[767px]:h-[72px] max-[767px]:justify-between max-[767px]:gap-3"
      >
        <a
          href="/"
          class="brand inline-flex shrink-0 items-center px-2 py-1.5 text-[var(--text)] max-[767px]:p-[5px]"
          aria-label="ALG AI Love GPU ホーム"
        >
          <BrandWordmark />
        </a>
        <nav class="desktop-nav" aria-label="メインナビゲーション">
          {navigation.map((item) => (
            <a
              href={item.href}
              aria-current={
                Astro.url.pathname.startsWith(item.href) ? 'page' : undefined
              }
            >
              {item.label}
            </a>
          ))}
        </nav>
        <div
          class="header-actions flex min-w-0 items-center gap-3 max-[767px]:gap-0.5"
        >
          <button
            type="button"
            class="icon-button icon-button--search"
            aria-label="サイト内を検索"
            data-search-open
          >
            <Icon name="search" />
          </button>
          <fieldset class="theme-picker" aria-label="表示テーマ">
            {(
              [
                ['light', 'sun', 'ライト'],
                ['dark', 'moon', 'ダーク'],
                ['system', 'monitor', 'OS設定に従う'],
              ] as const
            ).map(([value, icon, label]) => (
              <button
                type="button"
                class="icon-button icon-button--theme"
                data-theme-value={value}
                aria-label={label}
                aria-pressed="false"
                title={label}
              >
                <Icon name={icon} size={18} />
              </button>
            ))}
          </fieldset>
          <a href="/join/" class="participate-link">
            参加する <Icon name="arrow" size={16} />
          </a>
          <button
            type="button"
            class="mobile-toggle icon-button"
            id="menu-toggle"
            aria-label="メニューを開く"
            aria-expanded="false"
            aria-controls="mobile-nav"
          >
            <Icon name="menu" />
          </button>
        </div>
      </div>
      <nav
        id="mobile-nav"
        class="mobile-nav container"
        aria-label="モバイルナビゲーション"
      >
        {navigation.map((item) => (
          <a
            href={item.href}
            aria-current={
              Astro.url.pathname.startsWith(item.href) ? 'page' : undefined
            }
            class="mobile-nav-link"
          >
            {item.label}
          </a>
        ))}
        <a class="mobile-nav-link" href="/contact/">連絡先</a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer
      class="border-t border-[var(--line)] bg-[var(--surface-soft)] pt-[50px] max-[767px]:pt-[35px]"
    >
      <div class="container">
        <div
          class="flex justify-between gap-10 pb-10 max-[767px]:flex-col max-[767px]:gap-[30px]"
        >
          <div>
            <a
              href="/"
              class="brand inline-flex shrink-0 items-center px-2 py-1.5 text-[var(--text)] max-[767px]:p-[5px]"
              aria-label="AI Love GPU ホーム"
            >
              <BrandWordmark />
            </a>
            <p class="mb-0 mt-[18px] text-xs leading-[2] text-[var(--muted)]">
              好奇心を、動かそう。
              <br>
              AIを学び、GPUで試し、仲間とつくる。
            </p>
          </div>
          <div class="footer-links flex gap-[85px] max-[767px]:gap-[60px]">
            <div
              class="flex flex-col gap-[9px] text-[11px] text-[var(--muted)]"
            >
              <span
                class="mb-2 font-mono text-[9px] tracking-[0.15em] text-[var(--text)]"
                >EXPLORE</span
              >
              {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
            </div>
            <div
              class="flex flex-col gap-[9px] text-[11px] text-[var(--muted)]"
            >
              <span
                class="mb-2 font-mono text-[9px] tracking-[0.15em] text-[var(--text)]"
                >CONNECT</span
              >
              <a href="/contact/">連絡先・SNS</a>
              {site.github && <a href={site.github}>GitHub ↗</a>}
              <a href="/rss.xml">RSSフィード ↗</a>
              <a href="/privacy/">プライバシーポリシー</a>
            </div>
          </div>
        </div>
        <div class="footer-meta">
          <span>© {new Date().getFullYear()} AI Love GPU</span>
          <span>
            BUILT WITH CURIOSITY
            <span class="mx-[5px] text-[var(--accent)]">+</span>
            ASTRO
          </span>
        </div>
        {preview && (
          <p class="mb-0 pb-[15px] text-[10px] text-[var(--muted)]">
            このサイトは開発プレビューです。掲載内容は正式公開前に確認してください。
          </p>
        )}
      </div>
    </footer>
    <dialog
      class="search-dialog"
      id="search-dialog"
      aria-labelledby="search-title"
    >
      <div class="mb-5 flex items-center justify-between gap-[15px]">
        <h2
          id="search-title"
          class="text-base tracking-[-0.02em] max-[767px]:text-sm"
        >
          記事・プロジェクトを検索
        </h2>
        <button
          type="button"
          class="icon-button"
          data-search-close
          aria-label="検索を閉じる"
        >
          <Icon name="close" />
        </button>
      </div>
      <label for="search-input" class="sr-only"> 検索キーワード </label>
      <div class="search-field">
        <Icon name="search" />
        <input
          id="search-input"
          class="search-input"
          type="search"
          placeholder="例：機械学習、GPU、Python"
          autocomplete="off"
        >
      </div>
      <p id="search-status" role="status" aria-live="polite">
        キーワードを入力してください。
      </p>
      <ul id="search-results"></ul>
      <p class="search-hint">ESCで閉じる · 公開記事とプロジェクトを検索</p>
    </dialog>
    <script>
    import '../lib/browser';
    </script>
    <noscript>
      <style>
      .header-actions .icon-button {
        display: none;
      }
      #mobile-nav {
        display: flex;
        flex-wrap: wrap;
      }
      #category-filter-controls {
        display: none;
      }
      </style>
    </noscript>
    <style>
    .skip-link {
      position: fixed;
      top: 12px;
      left: 12px;
      z-index: 100;
      padding: 10px 20px;
      transform: translateY(-180%);
      background: var(--accent);
      color: var(--bg);
    }

    .skip-link:focus {
      transform: translateY(0);
    }

    .desktop-nav {
      display: flex;
      gap: 20px;
      margin-left: auto;
      font-size: 13px;
      font-weight: 500;
    }

    .desktop-nav a {
      padding: 12px 0;
    }

    .desktop-nav a:hover,
    .desktop-nav a[aria-current],
    .footer-links a:hover {
      color: var(--accent);
    }

    .icon-button {
      display: inline-grid;
      width: 40px;
      height: 40px;
      flex-shrink: 0;
      place-items: center;
      border: 0;
      border-radius: 6px;
      background: transparent;
      color: var(--muted);
    }

    .icon-button:hover {
      background: var(--surface);
      color: var(--accent);
    }

    .icon-button--theme[aria-pressed="true"] {
      background: var(--surface);
      color: var(--text);
      box-shadow: inset 0 0 0 1px var(--control-line);
    }

    .participate-link {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 9px 15px;
      border: 1px solid var(--line);
      border-radius: 5px;
      font-size: 12px;
    }

    .participate-link:hover {
      border-color: var(--accent);
    }

    .mobile-toggle,
    .mobile-nav {
      display: none;
    }

    .mobile-nav-link {
      padding-block: 10px;
      font-size: 13px;
    }

    .footer-meta {
      display: flex;
      justify-content: space-between;
      gap: 15px;
      padding-block: 21px;
      border-top: 1px solid var(--line);
      color: var(--muted);
      font-family: var(--font-mono);
      font-size: 9px;
      letter-spacing: 0.02em;
    }

    .footer-meta > span:last-child {
      font-size: 8px;
      letter-spacing: 0.08em;
    }

    .search-dialog {
      width: min(650px, calc(100% - 32px));
      max-height: 80vh;
      padding: 26px;
      margin: 12vh auto auto;
      overflow-y: auto;
      border: 1px solid var(--line);
      border-radius: 12px;
      background: var(--surface);
      color: var(--text);
      box-shadow: 0 25px 100px #0006;
    }

    .search-field {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 16px;
      border: 1px solid var(--line);
      border-radius: 6px;
      background: var(--bg);
      color: var(--accent);
    }

    .search-field:focus-within {
      border-color: var(--accent);
    }

    .search-input {
      width: 100%;
      min-width: 0;
      border: 0;
      outline: 0;
      background: transparent;
      color: var(--text);
      font-size: 14px;
    }

    .search-input::placeholder {
      color: var(--muted);
    }

    dialog::backdrop {
      background: #0009;
      backdrop-filter: blur(5px);
    }

    #search-status {
      margin: 20px 0;
      color: var(--muted);
      font-size: 12px;
    }

    #search-results {
      padding: 0;
      list-style: none;
    }

    #search-results :global(li) {
      padding: 16px 0;
      border-top: 1px solid var(--line);
    }

    #search-results :global(a) {
      color: var(--accent);
      font-size: 15px;
      font-weight: 600;
    }

    #search-results :global(p) {
      margin: 8px 0 0;
      color: var(--muted);
      font-size: 12px;
      line-height: 1.9;
    }

    .search-hint {
      padding-top: 15px;
      margin-bottom: 0;
      border-top: 1px solid var(--line);
      color: var(--muted);
      font-family: var(--font-mono);
      font-size: 10px;
    }

    @media (max-width: 1023px) {
      .desktop-nav {
        gap: 18px;
        font-size: 12px;
      }

      .participate-link {
        display: none;
      }
    }

    @media (max-width: 767px) {
      .desktop-nav {
        display: none;
      }

      .icon-button--search,
      .mobile-toggle {
        width: 32px;
        height: 32px;
      }

      .icon-button--theme {
        width: 28px;
        height: 28px;
      }

      .mobile-toggle {
        display: grid;
      }

      .mobile-nav.is-open {
        display: flex;
        flex-direction: column;
        gap: 0;
        padding-bottom: 15px;
      }

      .footer-meta {
        flex-direction: column;
        gap: 7px;
      }

      .footer-meta > span:last-child {
        font-size: 7px;
      }

      .search-dialog {
        padding: 20px;
      }
    }
    @media (max-width: 359px) {
      .icon-button--search,
      .mobile-toggle {
        width: 28px;
        height: 28px;
      }

      .icon-button--theme {
        width: 24px;
        height: 24px;
      }
    }
    </style>
  </body>
</html>
